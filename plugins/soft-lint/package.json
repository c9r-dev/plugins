{
  "name": "@c9r-dev/soft-lint",
  "version": "0.0.0",
  "description": "Ask a classifier plain-English yes/no questions about the lines a diff adds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c9r-dev/plugins.git",
    "directory": "plugins/soft-lint"
  },
  "type": "module",
  "bin": "dist/cli.js",
  "files": [
    "dist",
    "rules.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2"
  }
}
